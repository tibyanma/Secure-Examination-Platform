# SOEMS settings. Copy this file to a new file named ".env" (same folder as app.py)
# and fill in the values. Never upload .env to Git or share it.

# Generate a value with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=3ac863d46cf82dedb57a6d2ce4810c5f3308003d3031dc3224a6dd90a1a789d4

# Database (the defaults below match a normal XAMPP setup)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_exam_db
DB_POOL_SIZE=16

# Development only: show detailed errors and auto-reload. Never use on a real server.
# FLASK_DEBUG=1

# When you deploy for real students:
# SOEMS_ENV=production     (requires FLASK_SECRET_KEY and a non-root DB user with a password)
# SOEMS_HTTPS=1            (secure cookies; use when the site is served over https)
# SOEMS_TRUST_PROXY=1      (only if behind a reverse proxy you control)
